<Window x:Class="TaskManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Manager"
        Height="720"
        Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">

    <Window.Resources>

        <SolidColorBrush x:Key="WindowBackground" Color="#111315"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#181B1F"/>
        <SolidColorBrush x:Key="InputBackground" Color="#1C1F23"/>
        <SolidColorBrush x:Key="BorderColor" Color="#32353A"/>
        <SolidColorBrush x:Key="PrimaryText" Color="White"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#B3B7BE"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0 8 0 0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10 6"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8 4"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        </Style>

    </Window.Resources>

    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource PanelBackground}"
                CornerRadius="20"
                Padding="25">

            <ScrollViewer>

                <StackPanel>

                    <TextBlock Text="Task Manager"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"/>

                    <TextBlock Text="Create and manage tasks"
                               Margin="0 5 0 25"
                               Foreground="{DynamicResource SecondaryText}"/>

                    <Button x:Name="ThemeButton"
                            Content="Switch Theme"
                            Background="#6D28D9"
                            Click="ThemeButton_Click"/>

                    <TextBlock Text="Title"
                               Margin="0 20 0 0"
                               Foreground="{DynamicResource PrimaryText}"/>

                    <TextBox x:Name="TaskTitleTextBox"
                             Margin="0 6 0 16"/>

                    <TextBlock Text="Description"
                               Foreground="{DynamicResource PrimaryText}"/>

                    <TextBox x:Name="DescriptionTextBox"
                             Height="90"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0 6 0 16"/>

                    <TextBlock Text="Priority"
                               Foreground="{DynamicResource PrimaryText}"/>

                    <ComboBox x:Name="PriorityComboBox"
                              Margin="0 6 0 16">

                        <ComboBoxItem Content="Low"/>
                        <ComboBoxItem Content="Medium"/>
                        <ComboBoxItem Content="High"/>

                    </ComboBox>

                    <TextBlock Text="Type"
                               Foreground="{DynamicResource PrimaryText}"/>

                    <ComboBox x:Name="TypeComboBox"
                              Margin="0 6 0 16">

                        <ComboBoxItem Content="Personal"/>
                        <ComboBoxItem Content="Work"/>
                        <ComboBoxItem Content="Study"/>
                        <ComboBoxItem Content="Urgent"/>

                    </ComboBox>

                    <TextBlock Text="Deadline"
                               Foreground="{DynamicResource PrimaryText}"/>

                    <DatePicker x:Name="DeadlinePicker"
                                Margin="0 6 0 10"/>

                    <TextBox x:Name="DeadlineTimeTextBox"
                             Margin="0 0 0 20"
                             Text="12:00"/>

                    <Button Content="Add Task"
                            Background="#2563EB"
                            Click="AddTask_Click"/>

                    <Button Content="Update Task"
                            Background="#D97706"
                            Click="UpdateTask_Click"/>

                    <Button Content="Delete Task"
                            Background="#DC2626"
                            Click="DeleteTask_Click"/>

                    <Button Content="Toggle Complete"
                            Background="#16A34A"
                            Click="ToggleComplete_Click"/>

                </StackPanel>

            </ScrollViewer>

        </Border>

        <Grid Grid.Column="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource PanelBackground}"
                    CornerRadius="20"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Your Tasks"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"/>

                    <Grid Margin="0 18 0 0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchTextBox"
                                 Grid.Column="0"
                                 Height="38"
                                 TextChanged="FilterChanged"/>

                        <ComboBox x:Name="PriorityFilterComboBox"
                                  Grid.Column="2"
                                  SelectionChanged="FilterChanged">

                            <ComboBoxItem Content="All Priorities"/>
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Medium"/>
                            <ComboBoxItem Content="High"/>

                        </ComboBox>

                        <ComboBox x:Name="StatusFilterComboBox"
                                  Grid.Column="4"
                                  SelectionChanged="FilterChanged">

                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="In Progress"/>
                            <ComboBoxItem Content="Completed"/>

                        </ComboBox>

                    </Grid>

                </StackPanel>

            </Border>

            <ListBox Grid.Row="2"
                     x:Name="TasksListBox"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionChanged="TasksListBox_SelectionChanged">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <Border Background="{DynamicResource PanelBackground}"
                                CornerRadius="18"
                                Padding="18"
                                Margin="0 0 0 14">

                            <StackPanel>

                                <TextBlock Text="{Binding Title}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryText}"/>

                                <TextBlock Text="{Binding Description}"
                                           Margin="0 8 0 12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryText}"/>

                                <TextBlock Text="{Binding Priority}"
                                           Foreground="#F59E0B"/>

                                <TextBlock Text="{Binding Type}"
                                           Margin="0 6 0 0"
                                           Foreground="#60A5FA"/>

                                <TextBlock Text="{Binding Deadline}"
                                           Margin="0 8 0 0"
                                           Foreground="{DynamicResource SecondaryText}"/>

                                <TextBlock Margin="0 8 0 0"
                                           FontWeight="Bold">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Text"
                                                    Value="In Progress"/>

                                            <Setter Property="Foreground"
                                                    Value="#F59E0B"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsCompleted}"
                                                             Value="True">

                                                    <Setter Property="Text"
                                                            Value="✔ Completed"/>

                                                    <Setter Property="Foreground"
                                                            Value="#22C55E"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

        </Grid>

    </Grid>

</Window>